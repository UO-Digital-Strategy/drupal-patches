@@ -0,0 +1,16 @@
+# Integration with Search API.
+plugin.plugin_configuration.search_api_processor.metatag:
+  type: search_api.fields_processor_configuration
+  label: 'Metatag processor configuration'
+  mapping:
+    output_type:
+      type: string
+      label: 'Data selection'
+    # This structure is a nested array where the first level is the group name
+    # and the second level is the actual meta tag name.
+    tags:
+      type: sequence
+      sequence:
+        type: sequence
+        sequence:
+          type: metatag.metatag_tag.[%key]
diff --git a/src/Plugin/search_api/processor/MetaTags.php b/src/Plugin/search_api/processor/MetaTags.php
new file mode 100644
index 0000000000000000000000000000000000000000..c5d262bb79f12b6569f955f263fd6e711b096fb5
