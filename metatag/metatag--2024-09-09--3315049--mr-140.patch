+++ b/src/Plugin/search_api/processor/MetaTags.php
@@ -0,0 +1,200 @@
+<?php
+
+namespace Drupal\metatag\Plugin\search_api\processor;
+
+use Drupal\Core\Entity\EntityInterface;
+use Drupal\Core\Form\FormStateInterface;
+use Drupal\Core\Plugin\PluginFormInterface;
+use Drupal\search_api\Datasource\DatasourceInterface;
+use Drupal\search_api\Item\ItemInterface;
+use Drupal\search_api\Plugin\PluginFormTrait;
+use Drupal\search_api\Processor\ProcessorPluginBase;
+use Drupal\search_api\Processor\ProcessorProperty;
+use Drupal\search_api\SearchApiException;
+
+/**
+ * Adds entity type to the indexed data.
+ *
+ * @SearchApiProcessor(
+ *   id = "metatag",
+ *   label = @Translation("Meta tags"),
+ *   description = @Translation("Adds the selected meta tags for the indexed entities."),
+ *   stages = {
+ *     "add_properties" = -20
+ *   },
+ *   locked = false,
+ *   hidden = false
+ * )
+ */
+class MetaTags extends ProcessorPluginBase implements PluginFormInterface {
+
+  use PluginFormTrait;
+
+  /**
+   * {@inheritdoc}
+   */
+  public function defaultConfiguration() {
+    return [
+      'output_type' => 'overrides',
+    ];
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  public function buildConfigurationForm(array $form, FormStateInterface $form_state) {
+    $form['output_type'] = [
+      '#type' => 'radios',
+      '#title' => $this->t('Data selection'),
+      '#options' => [
+        'overrides' => $this->t('Only meta tags overridden on this entity, no defaults'),
+        'all' => $this->t('All meta tags including defaults'),
+      ],
+      '#description' => $this->t('In both cases the meta tag values will have tokens processed, the only difference is whether meta tags that come from global configurations will also be included. Using the "overridden" option can avoid duplication of words that are already indexed from other fields.'),
+      '#default_value' => $this->configuration['output_type'] ?? 'overrides',
+      '#required' => TRUE,
+    ];
+
+    // Load all metatags as possible options for inclusion.
+    $form['tags'] = [
+      '#type' => 'container',
+    ];
+    foreach ($this->getAllTags() as $group_name => $group) {
+      $form['tags'][$group_name] = [
+        '#type' => 'details',
+        '#title' => $group['label'],
+        '#description' => $group['description'] ?? '',
+        '#open' => TRUE,
+      ];
+      foreach ($group['tags'] as $tag_name => $tag) {
+        $form['tags'][$group_name][$tag_name] = [
+          '#type' => 'checkbox',
+          '#title' => $tag['label'],
+          '#description' => $tag['description'] ?? '',
+          '#default_value' => $this->configuration['tags'][$group_name][$tag_name] ?? FALSE,
+        ];
+      }
+    }
+
+    return $form;
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  public function submitConfigurationForm(array &$form, FormStateInterface $form_state) {
+    $values = $form_state->getValues();
+    foreach ($values['tags'] as &$group) {
+      if (is_array($group)) {
+        $group = array_filter($group);
+      }
+    }
+    $values['tags'] = array_filter($values['tags']);
+    $this->setConfiguration($values);
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  public function getPropertyDefinitions(DatasourceInterface $datasource = NULL): array {
+    $properties = [];
+
+    if ($datasource) {
+      // @todo Support other entity types.
+      $supported = [
+        'entity:node',
+        'entity:taxonomy_term',
+        'entity:user',
+      ];
+      if (in_array($datasource->getPluginId(), $supported)) {
+        $definition = [
+          'label' => 'Meta tags',
+          'description' => 'Selected meta tags from this entity.',
+          'type' => 'string',
+          'processor_id' => $this->getPluginId(),
+        ];
+        $properties['search_api_metatag'] = new ProcessorProperty($definition);
+      }
+    }
+
+    return $properties;
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  public function addFieldValues(ItemInterface $item) {
+    try {
+      $entity = $item->getOriginalObject()->getValue();
+    }
+    catch (SearchApiException $e) {
+      return;
+    }
+    if (!($entity instanceof EntityInterface)) {
+      return;
+    }
+
+    // No meta tags were selected on the settings form. Silly site admin.
+    if (empty($this->configuration)) {
+      return;
+    }
+
+    // Finished rendered output.
+    if ($this->configuration['output_type'] === 'all') {
+      $metatags = metatag_generate_entity_all_tags($entity);
+    }
+    // Just the per-entity overrides.
+    else {
+      $metatags = metatag_generate_entity_overrides($entity);
+    }
+
+    // If there are no meta tags to process there's nothing to do.
+    if (empty($metatags)) {
+      return;
+    }
+
+    $tag_definitions = \Drupal::service('plugin.manager.metatag.tag')->getDefinitions();
+
+    // Group all of the meta tag data in one property, rather than creating
+    // separate properties for each one.
+    $fields = $item->getFields(FALSE);
+    $fields = $this->getFieldsHelper()
+      ->filterForPropertyPath($fields, $item->getDatasourceId(), 'search_api_metatag');
+    foreach ($fields as $field) {
+      foreach ($this->getAllTags() as $group_name => $group) {
+        foreach ($group['tags'] as $tag_name => $tag) {
+          if (!empty($this->configuration['tags'][$group_name][$tag_name])) {
+            if (!empty($metatags[$tag_name])) {
+              if (!empty($metatags[$tag_name]['#attributes'])) {
+                $tag_object = new $tag_definitions[$tag_name]['class']([], $tag_name, $tag_definitions[$tag_name]);
+                $attribute_name = $tag_object->getHtmlValueAttribute();
+                if (!empty($metatags[$tag_name]['#attributes'][$attribute_name])) {
+                  if (is_array($metatags[$tag_name]['#attributes'][$attribute_name])) {
+                    $tag_output = implode(' ', $metatags[$tag_name]['#attributes'][$attribute_name]);
+                  }
+                  else {
+                    $tag_output = $metatags[$tag_name]['#attributes'][$attribute_name];
+                  }
+                  $field->addValue($tag_output);
+                }
+              }
+            }
+          }
+        }
+      }
+    }
+  }
+
+  /**
+   * Helper method to get array of metatags.
+   *
+   * @return array
+   *   A list of all meta tags enabled by the module.
+   */
+  protected function getAllTags() {
+    /** @var \Drupal\metatag\MetatagManager */
+    $tag_manager = \Drupal::service('metatag.manager');
+    return $tag_manager->sortedGroupsWithTags();
+  }
+
+}
