@@ -0,0 +1,134 @@
+<?php
+
+namespace Drupal\Tests\metatag\Functional;
+
+use Drupal\Tests\BrowserTestBase;
+
+/**
+ * Ensures that the Search API integration works as expected.
+ *
+ * @group metatag
+ */
+class SearchApiIntegration extends BrowserTestBase {
+
+  // Contains helper methods.
+  use MetatagHelperTrait;
+
+  /**
+   * {@inheritdoc}
+   */
+  protected static $modules = [
+    // This module.
+    'metatag',
+
+    // Needed for the field UI testing.
+    'node',
+    'field_ui',
+    'views_ui',
+
+    // The Search API system includes this submodule that makes a lot of pieces
+    // ready to go.
+    'search_api_db_defaults',
+  ];
+
+  /**
+   * {@inheritdoc}
+   */
+  protected $defaultTheme = 'stark';
+
+  /**
+   * Use the standard installer so that the default content types are available.
+   *
+   * This ensures that the Search API DB Defaults module has the expected
+   * configuration.
+   *
+   * {@inheritdoc}
+   */
+  protected $profile = 'standard';
+
+  /**
+   * {@inheritdoc}
+   */
+  protected function setUp(): void {
+    parent::setUp();
+
+    // Log in as user 1.
+    $this->loginUser1();
+
+    // Add the Metatag field to the content type.
+    $this->drupalGet('admin/structure/types/manage/page/fields/add-field');
+    $this->assertSession()->statusCodeEquals(200);
+    $edit = [
+      'label' => 'Metatag',
+      'field_name' => 'metatag',
+      'new_storage_type' => 'metatag',
+    ];
+    $this->submitForm($edit, 'Save and continue');
+    $this->submitForm([], 'Save field settings');
+    $this->assertSession()->statusCodeEquals(200);
+
+    // Load the Search API configuration.
+    $config = $this->config('search_api.index.default_index');
+
+    // Add the Metatag configuration.
+    $values = $config->get('processor_settings');
+    $values['metatag'] = [
+      // This checks all of the output, including the defaults.
+      'output_type' => 'all',
+      'tags' => [
+        'basic' => [
+          'title' => TRUE,
+          'description' => TRUE,
+        ],
+      ],
+    ];
+    $config->set('processor_settings', $values);
+
+    // Add the Metatag field to the index.
+    $values = $config->get('field_settings');
+    $values['metatag'] = [
+      'label' => 'Meta tags',
+      'datasource_id' => 'entity:node',
+      'property_path' => 'search_api_metatag',
+      'type' => 'text',
+    ];
+    $config->set('field_settings', $values);
+    $config->save();
+
+    $this->drupalGet('admin/config/search/search-api/index/default_index/fields');
+    $this->drupalGet('admin/config/search/search-api/index/default_index/processors');
+  }
+
+  /**
+   * Tests the Search API system adds Metatag.
+   */
+  public function testSearchApi() {
+    // Create a node.
+    $this->drupalGet('node/add/page');
+    $this->assertSession()->statusCodeEquals(200);
+    $edit = [
+      'title[0][value]' => 'Testing Search API',
+      'field_metatag[0][basic][title]' => 'mango passion fruit test',
+      'field_metatag[0][basic][description]' => 'Something goes here',
+    ];
+    $this->submitForm($edit, 'Save');
+    $this->assertSession()->statusCodeEquals(200);
+
+    // Verify the data for the node.
+    $node = $this->getNodeByTitle('Testing Search API');
+    $metatags = metatag_generate_entity_overrides($node);
+    print_r($metatags);
+
+    // @todo Look into why the content isn't indexed immediately.
+    $this->drupalGet('admin/config/search/search-api/index/default_index');
+    $this->submitForm([], 'Index now');
+
+    // Search for the node.
+    $this->drupalGet('search/content');
+    $this->assertSession()->statusCodeEquals(200);
+    $this->submitForm(['keys' => 'mango'], 'Search');
+    $this->assertSession()->statusCodeEquals(200);
+    $this->assertSession()->pageTextContains('Testing Search API');
+  }
+
+}
